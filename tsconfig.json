{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", ".cloudflare/types/**/*.d.ts", "**/*"],
	"exclude": [".cloudflare/output", "dist"],
	"compilerOptions": {
		/* Import path aliases */
		"paths": {
			"~/*": ["./src/*"]
		},

		/* Skip type checking all .d.ts files. */
		"skipLibCheck": true,
		"types": ["./.cloudflare/types/index.d.ts"],

		/* Enable JSX support */
		"jsx": "react-jsx",
		"jsxImportSource": "react",

		/* Specify a set of bundled library declaration files that describe the target runtime environment. */
		"lib": ["ESNext", "DOM"]
	}
}
